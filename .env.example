# Google Identity Services (browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional public overrides
NEXT_PUBLIC_API_URL=https://tanghiers-forecast-api.onrender.com
NEXT_PUBLIC_PRODUCT_SLUG=tanghiers-forecast
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Server-only Tanghiers auth (used by /api/auth/* routes)
TANGHIERS_API_BASE_URL=https://tanghiers-forecast-api.onrender.com
TANGHIERS_PRODUCT_SLUG=tanghiers-forecast
TANGHIERS_TERMS_VERSION=terms-2026-10
TANGHIERS_PRIVACY_VERSION=privacy-2026-10
TANGHIERS_AGE_VERSION=age-2026-10
